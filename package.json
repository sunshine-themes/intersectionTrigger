{
	"name": "intersectiontrigger",
	"version": "1.1.7",
	"description": "A lightweight TypeScript library that extends the IntersectionObserver API with intersection-based triggers, scroll-linked animations, and a plugin architecture. Zero dependencies.",
	"homepage": "https://sunshine-themes.github.io/intersectionTrigger/",
	"type": "module",
	"module": "./intersectiontrigger.esm.js",
	"main": "./intersectiontrigger.esm.js",
	"exports": {
		".": {
			"types": "./intersectiontrigger.d.ts",
			"default": "./intersectiontrigger.esm.js"
		},
		"./core": {
			"types": "./intersectiontrigger.d.ts",
			"default": "./intersectiontrigger.esm.js"
		},
		"./intersectiontrigger.esm.js": "./intersectiontrigger.esm.js",
		"./bundle": "./intersectiontrigger-bundle.esm.js",
		"./intersectiontrigger-bundle.esm.js": "./intersectiontrigger-bundle.esm.js",
		"./math": {
			"types": "./math.d.ts",
			"default": "./math.esm.js"
		},
		"./types": "./types/index.d.ts"
	},
	"types": "intersectiontrigger.d.ts",
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"intersection",
		"trigger",
		"animation",
		"animejs",
		"IntersectionObserver",
		"intersection-observer",
		"lazy-load",
		"performance",
		"lazy-loading",
		"viewport",
		"scroll",
		"toggle-class",
		"scrollbar"
	],
	"author": "Sherif Magdy",
	"maintainers": [
		{
			"name": "Sherif Magdy",
			"email": "eng.sherifmagdy.w@gmail.com"
		}
	],
	"scripts": {
		"build": "node --import ./scripts/ts-node.register.mjs scripts/build.ts",
		"build:watch": "node --import ./scripts/ts-node.register.mjs scripts/build -- -w",
		"dev": "start-test server http://localhost:3000 'conc --kill-others-on-fail -c \"auto\" \"npm:build:watch\" \"npm:test:build:watch\" \"npm:cy:open\"'",
		"format": "prettier --config .prettierrc.json \"{src,cypress}/**/*.{js,ts}\" --write",
		"lint": "eslint .",
		"server": "http-server -p 3000",
		"cy:open": "npx cypress open",
		"cy:run": "npx cypress run",
		"cy:record": "npx cypress run --record",
		"test": "start-test server http://localhost:3000 'run-s test:build cy:run'",
		"test:build": "node --import ./scripts/ts-node.register.mjs cypress/scripts/esbuild.ts",
		"test:build:watch": "npm run test:build -- -w",
		"validate": "run-s format lint test build"
	},
	"license": "MIT",
	"peerDependencies": {
		"animejs": "^4.0.0"
	},
	"bugs": {
		"url": "https://github.com/sunshine-themes/intersectionTrigger/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sunshine-themes/intersectionTrigger"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/preset-env": "^7.29.2",
		"@babel/preset-typescript": "^7.28.5",
		"@cypress/code-coverage": "^4.0.3",
		"@eslint/js": "^10.0.1",
		"@istanbuljs/nyc-config-typescript": "^1.0.2",
		"@types/fs-extra": "^11.0.4",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"ajv": "^8.18.0",
		"animejs": "^4.5.0",
		"babel-loader": "^10.1.1",
		"babel-plugin-istanbul": "^8.0.0",
		"concurrently": "^10.0.5",
		"core-js": "^3.49.0",
		"cypress": "^16.1.1",
		"esbuild": "^0.28.2",
		"esbuild-plugin-babel": "^0.2.3",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-cypress": "^7.0.2",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-prettier": "^5.5.5",
		"exec-sh": "^0.4.0",
		"fs-extra": "^11.3.4",
		"globals": "^17.4.0",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"nyc": "^18.0.0",
		"prettier": "^3.8.1",
		"source-map-support": "^0.5.21",
		"start-server-and-test": "^3.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"webpack": "^5.105.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"core-js@3.50.0": true,
		"@parcel/watcher@2.6.0": true,
		"cypress@16.1.1": true,
		"unrs-resolver@1.12.2": true
	}
}
